{
  "name": "abap-test-kit",
  "version": "1.1.0",
  "private": true,
  "description": "ABAP Test Kit: fluent test doubles and assertions for ABAP Unit. Off-stack lint and unit test toolchain (abaplint + transpiler).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/greltel/abap-test-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "abaplint abaplint.json",
    "transpile": "rimraf output && abap_transpile abap_transpile.json",
    "unit": "node transpiler/run_unit_tests.mjs",
    "unit:verbose": "node transpiler/run_unit_tests.mjs --verbose",
    "test": "npm run transpile && npm run unit",
    "ci": "npm run lint && npm test"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.72",
    "@abaplint/runtime": "^2.14.3",
    "@abaplint/transpiler-cli": "^2.14.3",
    "open-abap-core": "github:open-abap/open-abap-core#0c495ec0d059be72adc76b97848c6cc5ad8a1fe8",
    "open-abap-xco": "github:open-abap/open-abap-xco#1bd58800c12e7abd051ec79ef9420f2e1098d5f4",
    "rimraf": "^6.0.1"
  }
}
