{
  "input_folder": "src",
  "input_filter": [],
  "output_folder": "output",
  "libs": [
    {
      "folder": "deps/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "folder": "deps/open-abap-xco",
      "files": "/src/**/*.*"
    },
    {
      "folder": "abaplint-stubs",
      "files": "/**/*.abap",
      "exclude_filter": [
        "cl_abap_unit_assert",
        "if_abap_unit_constant",
        "cl_abap_testdouble"
      ]
    },
    {
      "folder": "transpiler/atdf",
      "files": "/**/*.abap"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError",
    "setup": {
      "filename": "../transpiler/setup.mjs",
      "preFunction": "setup"
    },
    "skip": [
      {
        "object": "ZCL_ATK",
        "class": "LTC_PARAMETER_SHAPES",
        "method": "GIVEN_GENERIC_DIGITS_WORKS"
      }
    ]
  }
}
